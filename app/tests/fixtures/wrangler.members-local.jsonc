{
 "name":"studytimely-room-usability-local",
 "main":"v2-worker.mjs",
 "compatibility_date":"2026-10-26",
 "workers_dev":false,
 "assets":{"directory":"../../dist/client","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"},
 "d1_databases":[{"binding":"DB","database_name":"studytimely-room-usability-synthetic","database_id":"00000000-0000-0000-0000-000000000031","migrations_dir":"../../migrations"}],
 "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"StudyRoom"}]},
 "migrations":[{"tag":"v2-study-rooms","new_sqlite_classes":["StudyRoom"]}],
 "vars":{"AUTH_HMAC":"synthetic-cf-review-local-key-never-a-production-secret","SUPPORT_EMAIL":"support@studytimely.com","FIXTURE_ACTIVITIES_QA":"true","FIXTURE_MEMBERS_QA":"true","FIXTURE_REVIEW_DISABLED":"true","FIXTURE_CF_REVIEW":"true","COMMUNITY_REVIEW_DAILY_NEURONS":"5000"},
 "observability":{"enabled":false}
}
