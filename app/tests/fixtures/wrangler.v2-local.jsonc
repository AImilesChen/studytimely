{
 "name":"studytimely-v2-local",
 "main":"v2-worker.mjs",
 "compatibility_date":"2026-10-26",
 "workers_dev":false,
 "assets":{"directory":"../../dist/client","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"},
 "d1_databases":[{"binding":"DB","database_name":"studytimely-v2-synthetic","database_id":"00000000-0000-0000-0000-000000000022","migrations_dir":"../../migrations"}],
 "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"StudyRoom"}]},
 "migrations":[{"tag":"v2-study-rooms","new_sqlite_classes":["StudyRoom"]}],
 "vars":{"AUTH_HMAC":"synthetic-v2-local-key-never-a-production-secret","SUPPORT_EMAIL":"support@studytimely.com"},
 "observability":{"enabled":false}
}
