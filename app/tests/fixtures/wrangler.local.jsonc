{
 "name":"studytimely-v1-1-local",
 "main":"local-worker.mjs",
 "compatibility_date":"2026-10-26",
 "workers_dev":false,
 "assets":{"directory":"../../dist/client","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"},
 "d1_databases":[{"binding":"DB","database_name":"studytimely-local-synthetic","database_id":"00000000-0000-0000-0000-000000000011","migrations_dir":"../../migrations"}],
 "vars":{"AUTH_HMAC":"synthetic-local-preview-key-not-for-production-use","SUPPORT_EMAIL":"support@studytimely.com"},
 "observability":{"enabled":false}
}
