# Copy these NAMES into local .dev.vars / production Worker Secrets only when ready.
# Create a dedicated Azure AI Content Safety F0 (Free) resource first.
# Keep disabled until resource eligibility, region/privacy notice and live checks are complete.
COMMUNITY_REVIEW_ENABLED=false
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=REPLACE_LOCALLY_NEVER_COMMIT_A_REAL_KEY
COMMUNITY_REVIEW_MONTHLY_LIMIT=4500
